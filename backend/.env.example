APP_NAME=Cloud Assignment Portal
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=sqlite:///./assignment_portal.db
STORAGE_BACKEND=local
AUTH_MODE=local
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,txt,png,jpg,jpeg,zip
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional cloud database/storage configuration
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres
# AUTH_MODE=supabase
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=DO_NOT_COMMIT_THIS
# SUPABASE_STORAGE_BUCKET=assignments
# SUPABASE_TEACHER_EMAILS=teacher@example.com
